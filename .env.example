OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=
OPENAI_DEEP_MODEL=

# Optional Claude/Anthropic provider. Leave blank until billing/API access is ready.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional local Obsidian Vault path. Used by `npm run world:index` to build a small local world index.
TIU_OBSIDIAN_VAULT_DIR=

# Set this before sharing a deployed link with testers.
TIU_ACCESS_PASSWORD= 

# Optional. If empty, TIU_ACCESS_PASSWORD is used to sign the access cookie.
TIU_ACCESS_SECRET= 

# Private-test admin account. There is no built-in default: admin login stays
# disabled until TIU_ADMIN_PASSWORD and a signing secret are both set.
# Never commit real values here — put them in .env.local or Vercel env settings.
TIU_ADMIN_ID=admin
TIU_ADMIN_PASSWORD=
TIU_ADMIN_DISPLAY_NAME=관리자
# Signs the admin cookie. Falls back to TIU_ACCESS_SECRET, then TIU_ACCESS_PASSWORD.
TIU_ACCOUNT_SECRET=

# Optional future cloud-storage bridge. Leave disabled until a cloud endpoint exists.
# When ready, set provider=http and point URL at your own Supabase/Firebase/custom bridge.
TIU_CLOUD_STORAGE_PROVIDER=disabled
TIU_CLOUD_STORAGE_URL=
TIU_CLOUD_STORAGE_TOKEN=
TIU_CLOUD_SYNC_TIMEOUT_MS=2500
